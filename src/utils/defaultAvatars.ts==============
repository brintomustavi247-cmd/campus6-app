/**
 * CAMPUS 6.0 — ১৮টা Built-in Anime Avatar
 * Files: public/avatars/1.png ... public/avatars/18.png
 */

export interface DefaultAvatar {
  id: string;
  url: string;
  fallback: string;
  label: string;
}

const D = 'https://api.dicebear.com/9.x/adventurer/svg';
const bg = ['ffd5dc', 'b6e3f4', 'c0aede', 'ffdfbf', 'd1d4f9'];

export const DEFAULT_AVATARS: DefaultAvatar[] = Array.from({ length: 18 }, (_, i) => {
  const n = i + 1;
  return {
    id: `av${n}`,
    url: `/avatars/${n}.png`,
    fallback: `${D}?seed=Chibi${n}&backgroundColor=${bg[i % 5]}`,
    label: `#${n}`,
  };
});

export const getAvatarById = (id: string): DefaultAvatar | undefined =>
  DEFAULT_AVATARS.find((a) => a.id === id);

export const getAvatarUrl = (id: string): string =>
  getAvatarById(id)?.url || DEFAULT_AVATARS[0].url;